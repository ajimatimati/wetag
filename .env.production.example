# weTag Production Environment Template
# Replace these with live production values when ready

NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://ajimatimati.github.io

# PostgreSQL with PostGIS connection string (from Supabase or Render)
DATABASE_URL=postgresql://user:password@host:5432/wetag_prod

# Redis Cache (Optional for free tier, fallback to in-memory)
REDIS_URL=redis://default:secret@redis-host:6379

# JWT Cryptographic Secrets (Generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_random_hex_key
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_key

# Payment Gateway (Paystack Nigeria)
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_key

# SMS OTP Provider (Termii Nigeria - optional)
TERMII_API_KEY=termii_replace_when_ready

# Oyo State 615 Emergency Hotline Webhook
OYO_615_DISPATCH_WEBHOOK=https://api.wetag.ng/webhooks/oyo615
